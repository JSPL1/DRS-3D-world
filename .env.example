# ============================================================
# DRS 3D WORLD — environment
# Copy to .env.local for development. Never commit the real file.
# ============================================================

# --- Required in production -------------------------------
# Signs every session token. Minimum 32 characters; the app refuses to start
# in production without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Storage ----------------------------------------------
# Directory holding the SQLite file. On Render this must point at a mounted
# disk (see render.yaml) or the database is wiped on every deploy.
DATA_DIR=./data

# Or point at an exact file, overriding DATA_DIR entirely:
# DATABASE_PATH=/var/data/drs.sqlite

# --- Site -------------------------------------------------
# Absolute base URL. Used for canonical tags, Open Graph images and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sessions ---------------------------------------------
SESSION_TIMEOUT_MINUTES=60
REMEMBER_ME_DAYS=30

# --- First-run seed ---------------------------------------
# Password given to the seeded demo accounts. Only used when the database is
# empty. Change it before the first production boot, then reset it from the UI.
SEED_PASSWORD=Drs@12345
